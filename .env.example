DEEPSEEK_API_KEY=your_key_here
# Optional when using a compatible deployment instead of DeepSeek's own API:
# DEEPSEEK_BASE_URL=https://your-endpoint/openai/v1
# DEEPSEEK_MODEL=your-deployment-name
# Optional local Qwen vision settings for image-only PDFs:
# QWEN_BASE_URL=http://localhost:11434
# QWEN_MODEL=qwen3-vl:2b-instruct
JUDGE_BASE_URL=http://localhost:11434
JUDGE_MODEL=gemma3:4b
