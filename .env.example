# Extraction model. Any OpenAI-compatible endpoint works. Example: OpenRouter.
HARNESS_MODEL_BASE_URL=https://openrouter.ai/api/v1
HARNESS_MODEL_API_KEY=your_key_here
HARNESS_MODEL=provider/model-name
# Optional public name shown in reports. OpenRouter model names are shown as they are;
# other endpoints show "deepseek-flash" unless this is set, so private names stay private.
# HARNESS_MODEL_LABEL=
# The older DEEPSEEK_API_KEY, DEEPSEEK_BASE_URL and DEEPSEEK_MODEL names still work.
# Optional local Qwen vision settings for image-only PDFs:
# QWEN_BASE_URL=http://localhost:11434
# QWEN_MODEL=qwen3-vl:2b-instruct
JUDGE_BASE_URL=http://localhost:11434
JUDGE_MODEL=gemma3:4b
